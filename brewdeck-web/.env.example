# Leave empty: the browser calls this app's own origin and Next proxies /api/* to the API
# (ADR-013). Pointing it at another origin breaks the SameSite=Strict refresh cookie.
NEXT_PUBLIC_API_BASE_URL=

# Where the Next server proxies /api/* (server-side only, never shipped to the browser).
API_PROXY_TARGET=http://localhost:8080

# Search engine indexing (server-side). Leave unset/false for local and staging: robots.txt disallows
# everything and pages carry noindex. Set to true only for a public production site.
ALLOW_INDEXING=
