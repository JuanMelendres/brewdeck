<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<!-- Migrated from spring-boot-starter-parent 3.5.16 to 4.1.1 (see
	     docs/decisions/ADR-008-spring-boot-4-migration.md) specifically to close
	     CVE-2026-59282 (spring-core, CVSS 7.5, data-binding property-path DoS - reachable via
	     BrewDeck's @ModelAttribute-bound query filters) and CVE-2026-47834 (spring-data-jpa,
	     CVSS 4.8), neither of which had a fix available in the 3.5.x line. -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.brewdeck</groupId>
	<artifactId>brewdeck-api</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name/>
	<description/>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>21</java.version>
		<!-- Post-migration OWASP finding (PR #117's own security.yml run): Boot 4.1.1's
		     default-managed Tomcat, 11.0.24, is itself vulnerable to nine CVEs disclosed after
		     that release shipped (CVE-2026-65905/65637 CVSS 9.8, CVE-2026-68525/65182 CVSS 9.1,
		     CVE-2026-65183/66422/68569 CVSS 8.1, CVE-2026-65927/68763 CVSS 7.5 - the same set
		     round 3 fixed on the 10.1.x line by pinning to 10.1.60). Fixed upstream in 11.0.25;
		     override Boot's managed `tomcat.version` property to 11.0.26, the latest 11.0.x
		     patch release on Maven Central, which supersedes the fix. Patch-only within the
		     line Boot already ships, no API changes. -->
		<tomcat.version>11.0.26</tomcat.version>
		<!-- Trivial same-line patch bump: log4j-api 2.25.4 emits non-RFC-8259-compliant
		     JSON for non-finite floating-point values in MapMessage.asJson()
		     (CVE-2026-49844, CVSS 5.9); fixed in 2.25.5. BrewDeck does not use
		     JsonTemplateLayout's message resolver, so the defect is not reachable here,
		     but the bump is free and low risk. -->
		<log4j2.version>2.26.1</log4j2.version>
		<commons-lang3.version>3.20.0</commons-lang3.version>
		<sonar.projectKey>JuanMelendres_brewdeck</sonar.projectKey>
		<sonar.organization>juanmelendres</sonar.organization>
		<sonar.host.url>https://sonarcloud.io</sonar.host.url>
		<sonar.coverage.jacoco.xmlReportPaths>
			${project.build.directory}/site/jacoco/jacoco.xml
		</sonar.coverage.jacoco.xmlReportPaths>
		<sonar.java.coveragePlugin>jacoco</sonar.java.coveragePlugin>
		<sonar.coverage.exclusions>
			**/*Application.java,**/*Request.java,**/*Response.java,**/config/**,**/ai/ClaudeRecipeSuggestionAdapter.java
		</sonar.coverage.exclusions>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.apache.logging.log4j</groupId>
				<artifactId>log4j-bom</artifactId>
				<version>${log4j2.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>org.apache.commons</groupId>
				<artifactId>commons-compress</artifactId>
				<version>1.26.0</version>
			</dependency>
			<!-- Override the swagger-ui webjar pulled in transitively by springdoc-openapi:
			     pinned to 5.32.15 (bundling the DOMPurify >=3.4.13 line that fixes
			     CVE-2026-75838, CVSS 5.1) because springdoc's own managed version lagged
			     behind. Re-validated as part of the Spring Boot 4 migration (springdoc bumped
			     2.8.17 -> 3.1.1, see ADR-008): 3.1.1 transitively manages swagger-ui 5.32.14
			     (`mvn dependency:tree -Dverbose=true -Dincludes=org.webjars:swagger-ui` shows
			     "version managed from 5.32.14"), which is still one patch behind this pin, so
			     the override remains necessary and does not need a further bump yet. -->
			<dependency>
				<groupId>org.webjars</groupId>
				<artifactId>swagger-ui</artifactId>
				<version>5.32.15</version>
			</dependency>
			<!-- CVE-2026-53914 (kotlin-stdlib/-reflect, transitive via com.anthropic:anthropic-java's
			     OkHttp/Jackson-Kotlin integration, resolved at 1.9.25) was suppressed in round 1
			     because the fixed line, Kotlin 2.4.20, only existed as Beta/RC. Kotlin 2.4.20 has
			     since reached a stable GA release on Maven Central (confirmed via
			     repo1.maven.org/maven2/.../kotlin-stdlib/maven-metadata.xml, no -Beta/-RC suffix).
			     Override the Kotlin artifacts on the classpath that still publish a real jar at
			     2.4.20 and drop the suppression: Kotlin's stdlib maintains binary backward
			     compatibility (code/metadata compiled against 1.9.x keeps working against a newer
			     stdlib/reflect), so this is a drop-in bump for a transitive-only runtime dependency,
			     not a build-toolchain change (BrewDeck is built with Maven and never invokes the
			     Kotlin compiler). kotlin-stdlib-common is intentionally NOT overridden here: as of
			     2.4.20 it is packaging=pom only (no jar published - confirmed by a 404 on its jar
			     coordinate on Maven Central, vs. 200 on its .pom), so okio-jvm's transitive
			     dependency on it stays unmanaged and resolves to whatever version is naturally
			     pulled (1.9.25); forcing 2.4.20 broke dependency resolution entirely. Validated by
			     the full Testcontainers-backed `./mvnw clean verify` run in this same change. -->
			<dependency>
				<groupId>org.jetbrains.kotlin</groupId>
				<artifactId>kotlin-stdlib</artifactId>
				<version>2.4.20</version>
			</dependency>
			<dependency>
				<groupId>org.jetbrains.kotlin</groupId>
				<artifactId>kotlin-stdlib-jdk7</artifactId>
				<version>2.4.20</version>
			</dependency>
			<dependency>
				<groupId>org.jetbrains.kotlin</groupId>
				<artifactId>kotlin-stdlib-jdk8</artifactId>
				<version>2.4.20</version>
			</dependency>
			<dependency>
				<groupId>org.jetbrains.kotlin</groupId>
				<artifactId>kotlin-reflect</artifactId>
				<version>2.4.20</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-crypto</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-core</artifactId>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>0.12.6</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>0.13.0</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>0.13.0</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-cache</artifactId>
		</dependency>
		<dependency>
			<groupId>com.github.ben-manes.caffeine</groupId>
			<artifactId>caffeine</artifactId>
		</dependency>
		<!-- Boot 4 carved FlywayAutoConfiguration out into spring-boot-flyway, gated behind this
		     starter; a bare flyway-core dependency no longer triggers it (silently skips
		     migrations - see ADR-008 for the full failure mode). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>3.1.1</version>
		</dependency>
		<!-- Boot 4's spring-boot-starter-web only autoconfigures the new Jackson 3
		     (tools.jackson) ObjectMapper. BrewDeck's RestAuthenticationEntryPoint and ~18 test
		     classes depend on the classic com.fasterxml.jackson.databind.ObjectMapper; this
		     opts back into Jackson2ObjectMapperBuilder autoconfiguration as a deliberate
		     compatibility shim rather than porting to the Jackson 3 API (see ADR-008). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-jackson2</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<version>42.7.13</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
		<!-- Boot 4 split spring-boot-starter-test into per-technology starters; -classic is
		     Boot's own backward-compatible aggregate covering the same set BrewDeck relied on
		     under Boot 3 (JUnit 5, Mockito, AssertJ, MockMvc, JSONassert, etc.). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test-classic</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-lang3</artifactId>
			<version>${commons-lang3.version}</version>
		</dependency>
		<!-- Spins up the PostgreSQL container -->
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Provides @Testcontainers and @Container annotations -->
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Spring Boot integration / @ServiceConnection -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Anthropic Java SDK for AI recipe suggestions -->
		<dependency>
			<groupId>com.anthropic</groupId>
			<artifactId>anthropic-java</artifactId>
			<version>2.52.0</version>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<executions>
					<execution>
						<id>default-compile</id>
						<phase>compile</phase>
						<goals>
							<goal>compile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
					<execution>
						<id>default-testCompile</id>
						<phase>test-compile</phase>
						<goals>
							<goal>testCompile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>com.diffplug.spotless</groupId>
				<artifactId>spotless-maven-plugin</artifactId>
				<version>3.4.0</version>
				<configuration>
					<java>
						<googleJavaFormat>
							<version>1.24.0</version>
						</googleJavaFormat>
						<removeUnusedImports />
						<trimTrailingWhitespace />
						<endWithNewline />
					</java>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-pmd-plugin</artifactId>
				<version>3.28.0</version>
				<configuration>
					<failOnViolation>true</failOnViolation>
					<printFailingErrors>true</printFailingErrors>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.12</version>
				<configuration>
					<excludes>
						<exclude>**/*Application.class</exclude>
						<exclude>**/*Request.class</exclude>
						<exclude>**/*Response.class</exclude>
						<exclude>**/config/**</exclude>
						<exclude>**/ai/ClaudeRecipeSuggestionAdapter.class</exclude>
					</excludes>
				</configuration>
				<executions>
					<!-- Prepares the JaCoCo agent -->
					<execution>
						<id>prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<!-- Generates the report after tests run -->
					<execution>
						<id>report</id>
						<phase>verify</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
					<execution>
					<id>check</id>
					<phase>verify</phase>
					<goals>
						<goal>check</goal>
					</goals>
					<configuration>
						<rules>
							<rule>
								<element>BUNDLE</element>
								<limits>
									<limit>
										<counter>LINE</counter>
										<value>COVEREDRATIO</value>
										<minimum>0.80</minimum> <!-- 80% -->
									</limit>
								</limits>
							</rule>
						</rules>
					</configuration>
				</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<profile>
			<id>security</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.owasp</groupId>
						<artifactId>dependency-check-maven</artifactId>
						<version>12.2.1</version>
						<configuration>
							<failBuildOnCVSS>7</failBuildOnCVSS>
							<formats>
								<format>HTML</format>
								<format>JSON</format>
							</formats>
							<suppressionFiles>
								<suppressionFile>dependency-check-suppressions.xml</suppressionFile>
							</suppressionFiles>
						</configuration>
						<executions>
							<execution>
								<goals>
									<goal>check</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>
