# Password-reset email delivery (Slice C.2)
BREWDECK_MAIL_ENABLED=false
BREWDECK_MAIL_FRONTEND_BASE_URL=http://localhost:3000
BREWDECK_MAIL_FROM=BrewDeck <no-reply@brewdeck.local>
# SMTP connection (required when BREWDECK_MAIL_ENABLED=true). Local: `docker compose up mailpit`,
# then use localhost:1025 with auth/starttls false and read mail at http://localhost:8025.
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_SMTP_AUTH=false
SPRING_MAIL_SMTP_STARTTLS=false

# Auth token lifetimes (Slice C.4)
# Access-token lifetime (ISO-8601 duration). Default 15 minutes.
AUTH_TOKEN_TTL=PT15M
# Refresh-token lifetime (ISO-8601 duration). Default 7 days.
AUTH_REFRESH_TTL=P7D

# Existing account promoted to ADMIN at startup (register it first, then set this and restart).
# Leave empty for no admin. Removing it later does not demote the account.
BREWDECK_ADMIN_EMAIL=

# In-memory rate limiting on auth endpoints (ADR-011). Keep true outside automated tests.
RATE_LIMIT_ENABLED=true

# OpenAPI spec + Swagger UI in the prod profile. Default false; enable only temporarily to debug.
API_DOCS_ENABLED=false
