# Password-reset email delivery (Slice C.2)
BREWDECK_MAIL_ENABLED=false
BREWDECK_MAIL_FRONTEND_BASE_URL=http://localhost:3000

# Auth token lifetimes (Slice C.4)
# Access-token lifetime (ISO-8601 duration). Default 15 minutes.
AUTH_TOKEN_TTL=PT15M
# Refresh-token lifetime (ISO-8601 duration). Default 7 days.
AUTH_REFRESH_TTL=P7D

# Existing account promoted to ADMIN at startup (register it first, then set this and restart).
# Leave empty for no admin. Removing it later does not demote the account.
BREWDECK_ADMIN_EMAIL=
