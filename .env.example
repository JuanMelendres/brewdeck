# Backend
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# AI recipe suggestions (ADR-016). The local profile defaults to a free local model through Ollama
# (`ollama serve`, model OLLAMA_MODEL). Set AI_ENABLED=false to turn the feature off, or
# AI_PROVIDER=claude plus ANTHROPIC_API_KEY to use the paid Claude API instead.
AI_ENABLED=true
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
ANTHROPIC_API_KEY=
